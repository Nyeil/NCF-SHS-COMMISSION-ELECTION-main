# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only key used by voting-code generation and database-backed rate limiting.
# Never prefix this variable with NEXT_PUBLIC_ and never commit its real value.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Any long random string; signs the student kiosk session JWT.
# Generate one: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
STUDENT_SESSION_SECRET=generate-a-secure-random-secret-at-least-32-bytes
